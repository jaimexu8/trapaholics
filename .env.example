# Copy to .env (chmod 600) and fill in. .env is gitignored — never commit it.
# Generate random secrets with:  openssl rand -hex 24
# Use letters/digits only (hex is ideal): values are substituted into
# YAML/TOML configs and passed through compose, so avoid quotes, spaces, '$', '#'.

# playit.gg agent secret key (Phase 1 tunnel). Keep this exact variable name.
PLAYIT_SECRET_KEY=

# Velocity modern-forwarding secret, shared by velocity, survival and creative.
VELOCITY_FORWARDING_SECRET=

# MariaDB root password (admin access / mysqldump for backups).
MARIADB_ROOT_PASSWORD=

# Password of the `luckperms` MariaDB user (database `luckperms`), used by
# LuckPerms on velocity, survival and creative.
LUCKPERMS_DB_PASSWORD=

# RCON passwords. RCON is only reachable inside the Docker network; used by
# `docker exec <container> rcon-cli`, the LuckPerms setup script and backups.
RCON_PASSWORD_SURVIVAL=
RCON_PASSWORD_CREATIVE=

# Discord webhook for the admin log channel (backup alerts; ARCHITECTURE §11.7).
DISCORD_WEBHOOK_URL=
