# Copy to .env (chmod 600) and fill in. .env is gitignored — never commit it.
# Generate random secrets with:  openssl rand -hex 24
# Use letters/digits only (hex is ideal): values are substituted into
# YAML configs and passed through compose, so avoid quotes, spaces, '$', '#'.

# Host uid/gid the minecraft and geyser containers run as, so ./minecraft and
# ./geyser stay owned by the deploy user (jt). Set to `id -u` / `id -g` of jt
# (e.g. 1002). Defaults to 1000 when unset.
HOST_UID=
HOST_GID=

# playit.gg agent secret key (Phase 1 tunnel). Keep this exact variable name.
PLAYIT_SECRET_KEY=

# MariaDB root password (admin access / mysqldump for backups).
MARIADB_ROOT_PASSWORD=

# Password of the `luckperms` MariaDB user (database `luckperms`).
LUCKPERMS_DB_PASSWORD=

# Password of the `coreprotect` MariaDB user (database `coreprotect`).
COREPROTECT_DB_PASSWORD=

# RCON password for the `minecraft` container. RCON is only reachable inside
# the Docker network; used by `docker exec minecraft rcon-cli`, the LuckPerms
# setup script and backups.
RCON_PASSWORD=

# Discord webhook for the admin log channel (backup alerts; ARCHITECTURE §11.7).
DISCORD_WEBHOOK_URL=
