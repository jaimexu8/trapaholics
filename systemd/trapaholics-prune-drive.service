[Unit]
Description=trapaholics prune Google Drive backups older than 30 days
Documentation=file:///home/jt/mc/docs/BACKUPS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jt
Group=jt
WorkingDirectory=/home/jt/mc
Environment=HOME=/home/jt
UMask=0077
ExecStart=/home/jt/mc/scripts/backup/prune-drive.sh
Nice=10
TimeoutStartSec=1h
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trapaholics-prune-drive
