# Pinned plugin sources for scripts/build-plugins.sh. Sourced by bash.
# Every entry is an exact tag + commit (built from source) or an exact URL +
# sha256 (downloaded). Bump these deliberately, never to "latest".

# --- CoreProtect CE (Paper 26.3) ---------------------------------------------
# v24.1 (public release) stops at 26.2. The "CoreProtect Community Edition v25.0"
# commit on master targets Paper 26.3 (LATEST_VERSION = "26.3").
COREPROTECT_REPO=https://github.com/PlayPro/CoreProtect.git
COREPROTECT_REF=master
COREPROTECT_COMMIT=a561c56c90f5b51264fd42e1b7a0b581db1e8345

# --- EssentialsX 2.22.1-dev --------------------------------------------------
# Jenkins build #1833 = 2.22.1-dev+28-f8724e2 (supports 26.3).
ESSENTIALSX_BUILD_URL=https://ci.ender.zone/job/EssentialsX/1833/artifact/jars
ESSENTIALSX_VERSION=2.22.1-dev+28-f8724e2
ESSENTIALSX_SHA256=5b8a1feb7c40a45d81e516bd077a7272d833c76cf829098743211999abd95929
ESSENTIALSXSPAWN_SHA256=707c3f2ec3ba9274f4b2f3c664d6b2447117ee100d074f08b02d1cd01b8cc6e3

# --- Floodgate (Paper / Spigot) ----------------------------------------------
# ARCHITECTURE.md cites 2.2.7; download.geysermc.org only publishes Spigot/Paper
# through 2.2.5 (2.2.7 on Modrinth is Fabric/NeoForge only). Pin the newest
# Spigot build and note the deviation in the PR.
FLOODGATE_URL=https://download.geysermc.org/v2/projects/floodgate/versions/2.2.5/builds/141/downloads/spigot
FLOODGATE_VERSION=2.2.5-b141
FLOODGATE_SHA256=21570aff9ce17d6983928e8552777760e1ede5050026b04c686b0ae112e6fd7e

# --- Geyser Standalone -------------------------------------------------------
GEYSER_URL=https://download.geysermc.org/v2/projects/geyser/versions/2.12.1/builds/1307/downloads/standalone
GEYSER_VERSION=2.12.1-b1307
